# Copy to .env.local and fill in real values.
#
# Supabase project settings (Settings -> API in the Supabase dashboard, or
# `supabase status` for a local stack).
#
# NOTE: NEXT_PUBLIC_* variables are exposed to the browser. The service-role
# key MUST stay server-side only — this app never ships it to the client.

# Project URL. For local dev: http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Service-role key (SERVER ONLY). Local dev value shown by `supabase status`.
# NEVER prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Secret salt used to HMAC client IPs before storing them. Use a long random
# string in production (e.g. `openssl rand -hex 32`). Changing it invalidates
# previously stored IP hashes (they are only used for abuse signals).
CLICKRANK_IP_HASH_SECRET=

# Optional: public anon key. Not currently used — all data access is
# server-side. Uncomment only if you add client-side Supabase calls.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
